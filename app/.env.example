# Server secret used to sign anonymous sessions. Generate a long random value.
APP_SECRET=replace-with-a-long-random-secret

# MySQL connection string
DATABASE_URL=mysql://user:password@host:3306/life_rpg

# Groq API (server-side only; never expose this as VITE_*)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: account identifier granted admin role
OWNER_UNION_ID=
